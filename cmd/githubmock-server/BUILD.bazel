load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "githubmock-server_lib",
    srcs = ["main.go"],
    importpath = "go.f110.dev/githubmock/cmd/githubmock-server",
    visibility = ["//visibility:private"],
    deps = [
        "//:githubmock",
        "//cmd/githubmock-server/internal/adminui",
        "//cmd/githubmock-server/internal/config",
